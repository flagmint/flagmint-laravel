{
  "name": "flagmint/laravel",
  "description": "Flagmint Laravel SDK — service provider, facade, Blade, middleware",
  "type": "library",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Flagmint",
      "homepage": "https://flagmint.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "flagmint/php-sdk": "^0.1",
    "illuminate/support": "^11.44|^12.0",
    "illuminate/contracts": "^11.44|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.12|^10.0",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "config": {
    "audit": {
      "block-insecure": false
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "autoload": {
    "psr-4": {
      "Flagmint\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flagmint\\Laravel\\Tests\\": "tests/",
      "Flagmint\\Tests\\": "../php-sdk/tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Flagmint\\Laravel\\FlagmintServiceProvider"
      ],
      "aliases": {
        "Flagmint": "Flagmint\\Laravel\\Facades\\Flagmint"
      }
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../flagmint-php-sdk",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "vcs",
      "url": "https://github.com/flagmint/flagmint-php-sdk.git"
    }
  ],
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
