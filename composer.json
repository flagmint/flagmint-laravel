{
  "name": "flagmint/laravel",
  "description": "Flagmint Laravel SDK — service provider, facade, Blade, middleware",
  "type": "library",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Flagmint",
      "homepage": "https://flagmint.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "flagmint/php-sdk": "^0.1",
    "illuminate/support": "^11.44|^12.0",
    "illuminate/contracts": "^11.44|^12.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.8",
    "orchestra/testbench": "^9.12|^10.0",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "config": {
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "autoload": {
    "psr-4": {
      "Flagmint\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flagmint\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Flagmint\\Laravel\\FlagmintServiceProvider"
      ],
      "aliases": {
        "Flagmint": "Flagmint\\Laravel\\Facades\\Flagmint"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
